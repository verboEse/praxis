<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ excerpt or site.description }}">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <header>
    <div class="header-main">
      <div class="container">
        <div class="header-content">
          <div class="logo-area">
            <a href="/">
              <img src="/assets/images/Dreyer-Ciszewski_Logo-Pfote.png" alt="{{ site.title }} Logo" class="logo">
            </a>
            <div class="logo-text">
              <h1 class="site-title">{{ site.title }}</h1>
              <p class="site-tagline">{{ site.owner }}</p>
            </div>
          </div>
          <nav>
            <ul class="nav-menu">
              <li><a href="/">Willkommen</a></li>
              <li><a href="/pages/team/">Team</a></li>
              <li class="has-submenu">
                <a href="/pages/leistungen/">Leistungen <span class="submenu-indicator">▾</span></a>
                <ul class="submenu">
                  <li><a href="/pages/gesundheitsvorsorge/">Gesundheitsvorsorge</a></li>
                  <li><a href="/pages/diagnostik/">Diagnostik</a></li>
                  <li><a href="/pages/chirurgie/">Chirurgie</a></li>
                  <li><a href="/pages/behandlungsspektrum-medizinische-teilgebiete/">Behandlungsspektrum</a></li>
                  <li><a href="/pages/weitere-serviceleistungen/">Weitere Serviceleistungen</a></li>
                </ul>
              </li>
              <li><a href="/pages/praxis/">Praxis</a></li>
              <li><a href="/pages/anfahrt/">Anfahrt</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </header>

  {{ content | safe }}

  <footer>
    <div class="container">
      <div class="footer-content">
        <div class="footer-text">
          <a href="/pages/impressum/">Impressum</a>
          <span class="separator">|</span>
          <span>&copy; 2026 {{ site.title }}</span>
        </div>
        <img src="/assets/images/Dreyer-Ciszewski_Logo-ganz.png" alt="{{ site.title }}" class="footer-logo">
      </div>
    </div>
  </footer>
  
  <script src="/assets/js/carousel.js"></script>
  <script src="/assets/js/lightbox.js"></script>
</body>
</html>
